#!/usr/bin/env python3
import sys
import os
import re
import shutil
import tempfile
import subprocess
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gio, GLib, Gdk


class Uncork(Gtk.Application):

    def __init__(self):
        super().__init__(
            application_id="xyz.technoz3n.uncork",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )

        self.css_provider = None

    def do_activate(self):
        self.load_css()

        self.win = Gtk.ApplicationWindow(
            application=self,
            title="uncork"
        )
        self.win.set_default_size(460, 390)
        self.win.set_resizable(False)

        outer = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=18
        )

        outer.set_margin_top(24)
        outer.set_margin_bottom(24)
        outer.set_margin_start(24)
        outer.set_margin_end(24)

        self.win.set_child(outer)

        header = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=4
        )

        title = Gtk.Label(label="uncork", xalign=0)
        title.add_css_class("app-title")

        subtitle = Gtk.Label(
            label="bring windows applications into linux.",
            xalign=0
        )
        subtitle.add_css_class("dim-label")

        header.append(title)
        header.append(subtitle)
        outer.append(header)

        form = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=8
        )

        outer.append(form)

        exe_label = Gtk.Label(
            label="windows executable",
            xalign=0
        )
        exe_label.add_css_class("field-label")
        form.append(exe_label)

        file_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=8
        )

        self.exe_entry = Gtk.Entry()
        self.exe_entry.set_hexpand(True)
        self.exe_entry.set_placeholder_text("/path/to/application.exe")

        browse_btn = Gtk.Button(label="browse")
        browse_btn.connect("clicked", self.on_browse_clicked)

        file_box.append(self.exe_entry)
        file_box.append(browse_btn)

        form.append(file_box)

        name_label = Gtk.Label(
            label="application name",
            xalign=0
        )
        name_label.add_css_class("field-label")
        form.append(name_label)

        self.name_entry = Gtk.Entry()
        self.name_entry.set_placeholder_text("my application")

        form.append(self.name_entry)

        prefix_label = Gtk.Label(
            label="wine prefix",
            xalign=0
        )
        prefix_label.add_css_class("field-label")
        form.append(prefix_label)

        self.prefix_entry = Gtk.Entry()
        self.prefix_entry.set_text(
            os.path.expanduser("~/.wine")
        )

        form.append(self.prefix_entry)

        self.create_btn = Gtk.Button(
            label="integrate application"
        )
        self.create_btn.add_css_class("suggested-action")
        self.create_btn.connect(
            "clicked",
            self.on_create_clicked
        )

        outer.append(self.create_btn)

        self.status_label = Gtk.Label(
            label="",
            xalign=0
        )
        self.status_label.set_wrap(True)

        outer.append(self.status_label)

        self.win.present()

    def load_css(self):
        css = """
        * {
            font-family: "Rubik";
        }

        window {
            background-color: @theme_bg_color;
            color: @theme_fg_color;
        }

        .app-title {
            font-size: 26px;
            font-weight: 600;
        }

        .dim-label {
            opacity: 0.65;
            font-size: 13px;
        }

        .field-label {
            font-size: 13px;
            font-weight: 500;
            margin-top: 7px;
        }

        entry {
            padding: 9px 11px;
            border-radius: 9px;
        }

        button {
            padding: 9px 14px;
            border-radius: 9px;
        }

        button.suggested-action {
            border-radius: 10px;
            font-weight: 600;
        }

        button.suggested-action:hover {
            opacity: 0.88;
        }

        .status-success {
            color: #98c379;
        }

        .status-error {
            color: #e06c75;
        }
        """

        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode("utf-8"))

        display = Gdk.Display.get_default()

        if display:
            Gtk.StyleContext.add_provider_for_display(
                display,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self.css_provider = provider

    def on_browse_clicked(self, widget):
        dialog = Gtk.FileDialog(
            title="choose a windows executable"
        )

        exe_filter = Gtk.FileFilter()
        exe_filter.set_name("Windows executables (*.exe)")
        exe_filter.add_pattern("*.exe")
        exe_filter.add_pattern("*.EXE")

        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(exe_filter)

        dialog.set_filters(filters)

        dialog.open(
            self.win,
            None,
            self.on_file_selected
        )

    def on_file_selected(self, dialog, result):
        try:
            file = dialog.open_finish(result)
            file_path = file.get_path()

            if not file_path:
                self.show_status(
                    "could not access the selected file",
                    error=True
                )
                return

            self.exe_entry.set_text(file_path)

            base_name = Path(file_path).stem

            suggested_name = " ".join(
                word.capitalize()
                for word in re.split(r"[_-]+", base_name)
                if word
            )

            self.name_entry.set_text(suggested_name)

            self.show_status("executable selected")

        except GLib.Error:
            return

    def validate_inputs(self):
        exe_path = os.path.abspath(
            os.path.expanduser(
                self.exe_entry.get_text().strip()
            )
        )

        app_name = self.name_entry.get_text().strip()

        wine_prefix = os.path.abspath(
            os.path.expanduser(
                self.prefix_entry.get_text().strip()
            )
        )

        if not exe_path or not app_name or not wine_prefix:
            raise ValueError("all fields are required")

        if not os.path.isfile(exe_path):
            raise ValueError("invalid executable path")

        if Path(exe_path).suffix.lower() != ".exe":
            raise ValueError("selected file is not an .exe")

        if not os.path.isdir(wine_prefix):
            raise ValueError("wine prefix directory does not exist")

        if not shutil.which("wine"):
            raise RuntimeError("wine could not be found")

        return exe_path, app_name, wine_prefix

    def extract_icon(self, exe_path, icon_path):
        wrestool = shutil.which("wrestool")
        icotool = shutil.which("icotool")

        if not wrestool or not icotool:
            return False

        with tempfile.TemporaryDirectory() as temp_dir:

            result = subprocess.run(
                [
                    wrestool,
                    "-x",
                    "-t",
                    "14",
                    exe_path
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL
            )

            if result.returncode != 0 or not result.stdout:
                return False

            extraction = subprocess.run(
                [
                    icotool,
                    "-x",
                    "-o",
                    temp_dir,
                    "-"
                ],
                input=result.stdout,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )

            if extraction.returncode != 0:
                return False

            png_files = list(
                Path(temp_dir).glob("*.png")
            )

            if not png_files:
                return False

            candidates = []

            for png in png_files:
                try:
                    size = png.stat().st_size
                    candidates.append((size, png))
                except OSError:
                    continue

            if not candidates:
                return False

            candidates.sort(reverse=True, key=lambda item: item[0])

            selected = candidates[0][1]

            shutil.copy2(selected, icon_path)

            return True

    @staticmethod
    def desktop_escape(value):
        return (
            str(value)
            .replace("\\", "\\\\")
            .replace("\n", "")
            .replace("\r", "")
        )

    @staticmethod
    def exec_escape(value):
        value = str(value)

        escaped = []

        for char in value:
            if char in ('\\', '"', '`', '$'):
                escaped.append('\\')

            escaped.append(char)

        return '"' + ''.join(escaped) + '"'

    def generate_launcher(
        self,
        exe_path,
        app_name,
        wine_prefix
    ):
        app_dir = Path.home() / ".local/share/applications"

        icon_dir = (
            Path.home()
            / ".local/share/icons/hicolor/256x256/apps"
        )

        app_dir.mkdir(parents=True, exist_ok=True)
        icon_dir.mkdir(parents=True, exist_ok=True)

        safe_name = re.sub(
            r"[^a-zA-Z0-9_-]+",
            "-",
            app_name.lower()
        ).strip("-")

        if not safe_name:
            raise ValueError("application name contains no usable characters")

        desktop_file = app_dir / f"wine-{safe_name}.desktop"
        icon_path = icon_dir / f"wine-{safe_name}.png"

        counter = 2

        while desktop_file.exists():
            desktop_file = app_dir / f"wine-{safe_name}-{counter}.desktop"
            icon_path = icon_dir / f"wine-{safe_name}-{counter}.png"
            counter += 1

        icon_value = "wine"

        if self.extract_icon(exe_path, str(icon_path)):
            icon_value = icon_path.stem

        exe_dir = os.path.dirname(exe_path)

        command = (
            f"env WINEPREFIX={self.exec_escape(wine_prefix)} "
            f"wine {self.exec_escape(exe_path)}"
        )

        content = f"""[Desktop Entry]
Type=Application
Name={self.desktop_escape(app_name)}
Comment=Launched via Wine
Exec={command}
Path={self.exec_escape(exe_dir)}
Icon={icon_value}
Terminal=false
StartupNotify=true
Categories=Wine;X-Wine-Programs;Application;
"""

        desktop_file.write_text(
            content,
            encoding="utf-8"
        )

        desktop_file.chmod(0o755)

        updater = shutil.which("update-desktop-database")

        if updater:
            subprocess.run(
                [updater, str(app_dir)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False
            )

        return desktop_file

    def on_create_clicked(self, widget):
        self.create_btn.set_sensitive(False)

        try:
            exe_path, app_name, wine_prefix = (
                self.validate_inputs()
            )

            launcher = self.generate_launcher(
                exe_path,
                app_name,
                wine_prefix
            )

            self.show_status(
                f"'{app_name}' successfully integrated",
                error=False
            )

        except (ValueError, RuntimeError, OSError) as error:
            self.show_status(
                str(error),
                error=True
            )

        except Exception as error:
            self.show_status(
                f"unexpected error: {error}",
                error=True
            )

        finally:
            self.create_btn.set_sensitive(True)

    def show_status(self, message, error=False):
        escaped = GLib.markup_escape_text(message)

        self.status_label.set_markup(
            f'<span class="{"status-error" if error else "status-success"}">'
            f'{escaped}</span>'
        )


if __name__ == "__main__":
    app = Uncork()
    sys.exit(app.run(sys.argv))
